<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
    </integer-array>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- "Default home" tile that opens Android's home-screen picker, for TVs whose settings have one
         (most Android TVs don't; the tile only appears when the page exists). Off by default. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>

    <!-- Reduced motion: for TVs whose GPU cannot keep up (MediaTek MT5895 on Android 10 is the known case).
         true keeps the GPU drawing path but calms the movement: a stiff highlight spring with no bounce,
         tiles that zoom without overshoot, shorter fades and no tile entrance when Home comes back. Set it
         here or with "reduced_motion": true in a theme's config.json; false keeps the normal motion. -->
    <bool name="reduced_motion">false</bool>

    <!-- Sunset backdrop behind everything: a dark gradient that follows the clock, with a warm
         horizon glow around sunrise and sunset. 0 keeps the plain background (the default);
         1 to 100 sets its opacity. Around 60 reads clearly without hiding a wallpaper. -->
    <integer name="sky_intensity">0</integer>

    <!-- Weather line in the top-left corner. Off until weather_enabled is true AND both coordinates
         are set; until then nothing is requested and the line stays hidden. The request is one
         small HTTPS GET to open-meteo.com (no account, no location permission) only while Home is
         in front; tools/weather.py prints coordinates for a town name. -->
    <bool name="weather_enabled">false</bool>
    <string name="weather_latitude" translatable="false"></string>
    <string name="weather_longitude" translatable="false"></string>
    <!-- Optional place name shown before the temperature ("Paris 14° · Nuageux"); empty hides it. -->
    <string name="weather_place" translatable="false"></string>
    <!-- celsius (default) or fahrenheit. -->
    <string name="weather_units" translatable="false">celsius</string>
    <!-- How long a reading stays fresh before another request is made, 15 to 720 minutes. -->
    <integer name="weather_refresh_minutes">30</integer>

    <!-- Dock shelves (fork feature, docs/dock-shelves.md): content rows above the dock, built from the
         Android TV channels the dock apps publish themselves — Stremio's "Continuer de regarder",
         Spotify's covers, and for any tile that claims youtube.com links (TizenTube) the YouTube app's
         recommendations and watch-next list. Read from the TV provider, no account or API; a tile whose
         app publishes nothing (GoldenOTT) keeps its plain app name. TV builds that make READ_TV_LISTINGS
         a runtime permission ask once (Allow/Deny the first time), others grant it at install. false
         hides every shelf for good. -->
    <bool name="stremio_shelf">true</bool>
    <!-- Download artwork over https (Stremio's metadata CDNs, i.scdn.co, i.ytimg.com) instead of showing
         coloured placeholders. Requests only run while a shelf is on screen; images are cached (8 MB
         memory, 40 MB disk). -->
    <bool name="stremio_shelf_posters">true</bool>
    <!-- How many rows to build per tile (1 = the first channel row, or the merged resume row for
         YouTube), 1 to 3. Rows that would run into the clock/greeting are dropped: the band above the
         dock takes one 96x144 dp row on a 1080p TV, and two on a 720p one. -->
    <integer name="stremio_shelf_rows">1</integer>
    <!-- Most cards per row, 1 to 20. -->
    <integer name="stremio_shelf_max_items">12</integer>
    <!-- The dock app whose cards follow their own deep links and show 2:3 posters (Stremio, by default). -->
    <string name="stremio_shelf_package" translatable="false">com.stremio.one</string>

    <!-- Now playing (fork feature, docs/now-playing.md): the track or video the focused app is playing,
         with its artwork and the glow's colour taken from it. Needs the one-time notification-access
         grant; without it the card is simply absent, the app name stays. false turns it off for good. -->
    <bool name="now_playing">true</bool>

    <!-- Football row (fork feature, docs/football.md): today's matches from football-data.org on one
         dock tile, with live scores. Needs a free token (football-data.org/client/register); without
         one the row stays hidden. The token can also live in football-token.txt in the theme folder,
         so a config.json that gets shared never carries it. Competitions are API codes; a team rule
         keeps only the listed clubs inside a competition (here Real Madrid and Barcelona in La Liga,
         while every Ligue 1, Champions League and Premier League match is shown). Channels are shown
         on the cards; picking a match opens the football app, which is where the streams live. -->
    <bool name="football">true</bool>
    <string name="football_token" translatable="false"></string>
    <string name="football_competitions" translatable="false">FL1,CL,PL,PD</string>
    <string name="football_teams" translatable="false">PD:Real Madrid,FC Barcelona</string>
    <string name="football_channels" translatable="false">FL1=Canal+|CL=beIN Sports 1|PL=Canal+|PD=beIN Sports 1</string>
    <string name="football_tile" translatable="false">com.new_Golden_ott_user.app</string>
</resources>

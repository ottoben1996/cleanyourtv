<?xml version="1.0" encoding="utf-8"?>
<!-- One labelled row of the Stremio shelf; rows are stacked inside @id/shelfBox. The label is the
     channel name (for example "Continuer de regarder") and sits on the same 56dp left edge as the
     posters, which is also the header's text edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/shelfLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAllCaps="true"
        android:textColor="#73FFFFFF"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:importantForAccessibility="no" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelfRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none" />
</LinearLayout>

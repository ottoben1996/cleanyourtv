<?xml version="1.0" encoding="utf-8"?>
<!-- One Stremio shelf poster: card, progress line and the title underneath. The whole item takes
     focus (children are blocked), so D-pad left/right moves along the row of posters. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shelfItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/shelfCard"
        android:layout_width="96dp"
        android:layout_height="144dp">

        <ImageView
            android:id="@+id/shelfPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/shelfLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="34sp"
            android:textColor="#4DFFFFFF"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/shelfShade"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shelf_shade"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/shelfProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressTint="#E6FFFFFF"
            android:progressBackgroundTint="#33000000"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/shelfBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/shelf_badge_bg"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/outfit"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/shelfTitle"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#F2FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:alpha="0.6"
        android:importantForAccessibility="no" />
</LinearLayout>
